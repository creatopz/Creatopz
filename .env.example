# Copy these values from your Supabase project:
# Project Settings -> API

# Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# anon / public key (safe for the browser — access is controlled by RLS policies)
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# NEVER put the service_role key here or in any file that ships to the browser.
# This is a static site, so these values are copied directly into
# js/supabase-client.js rather than read from a real .env file at build time.
