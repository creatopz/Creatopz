# --- Supabase ---------------------------------------------------------------
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-only, NEVER expose to the browser or commit it.
# Used for: writing verified subscriptions, admin moderation actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---------------------------------------------------------------------
# Used to build absolute redirect URLs for email links (magic link, password
# reset, OAuth). Must exactly match a Redirect URL you allow in
# Supabase → Authentication → URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Razorpay (payments) -------------------------------------------------------
# Dashboard → Settings → API Keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# Dashboard → Settings → Webhooks → create a webhook pointing at
# https://yourdomain.com/api/subscriptions/webhook, subscribed to
# payment.captured + payment.failed, and paste its secret here.
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
