# Copy this file to .env.local for local development, or paste these into
# your host's environment variable settings (e.g. Vercel Project Settings →
# Environment Variables) for production.

# --- Supabase ---------------------------------------------------------------
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_, never send
# to the browser. Used only by API routes / server actions under
# src/lib/supabase/admin.ts, all of which re-verify the caller server-side
# before using it (see src/lib/admin-guard.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Razorpay ----------------------------------------------------------------
# Dashboard → Settings → API Keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-key-secret
# Dashboard → Settings → Webhooks → (create one pointed at
# https://yourdomain.com/api/payments/webhook, subscribed to
# payment.captured) → copy the secret you set there.
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
# Public key id, safe for the browser — same value as RAZORPAY_KEY_ID.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
